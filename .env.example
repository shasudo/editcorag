####################################################################
# EditcoRAG configuration. Copy to .env and edit.
# Every value below is a default - uncomment only what you change.
####################################################################

# ----------------------------------------------------------------- LLM
# Answering runs on Groq. This is the only part of the system that is not
# local: retrieved excerpts are sent to Groq to be turned into an answer.
# Documents, the index and retrieval all stay on this machine.
#
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Any model Groq serves. Check https://console.groq.com/docs/models
LOCALRAG_LLM_MODEL=openai/gpt-oss-120b
# Only needed to point at a proxy; Groq's endpoint is the default.
#LOCALRAG_LLM_BASE_URL=https://api.groq.com/openai/v1
LOCALRAG_LLM_TEMPERATURE=0.0
LOCALRAG_LLM_TIMEOUT_S=180

# ---------------------------------------------------------- embeddings
# bge-m3 is multilingual with an 8k context. Changing this invalidates the
# index - the stored model name is checked on open, and the vector width comes
# from the model itself, so there is no dimension to configure.
LOCALRAG_EMBED_MODEL=BAAI/bge-m3
LOCALRAG_EMBED_BATCH_SIZE=8
LOCALRAG_EMBED_DEVICE=auto          # auto | cuda | mps | cpu

# ------------------------------------------------------------ reranker
# The single biggest answer-quality lever. Multilingual cross-encoder.
LOCALRAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
LOCALRAG_RERANK_TOP_N=8

# ----------------------------------------------------------- retrieval
LOCALRAG_DENSE_K=50
LOCALRAG_FTS_K=50
LOCALRAG_CONTEXT_TOKEN_BUDGET=6000
# Below this reranker score (0..1) the graph says "not in this document"
# instead of answering. Calibrate with `editcorag eval`.
LOCALRAG_ABSTAIN_SCORE_MIN=0.30

# --------------------------------------------------------------- graph
# careful = grade retrieval, rewrite the query on a weak hit, verify the
#           answer is grounded before returning it
# fast    = retrieve -> rerank -> generate, no grading round-trips
LOCALRAG_ANSWER_MODE=careful
# Grader nodes need reliable JSON-schema output. Verify with
# `editcorag doctor --check-structured`; set false if your model cannot.
LOCALRAG_ENABLE_GRADERS=true
LOCALRAG_MAX_QUERY_REWRITES=2

# ----------------------------------------------------------------- OCR
# RapidOCR on every platform: portable ONNX, no system binary, and identical
# output on Windows and macOS. A document must not index differently depending
# on whose machine opened it, which is why there is no backend to choose.
#
# IMPORTANT - set this to the languages actually in your PDF.
# Comma-separated ISO 639-1 codes ("en", "de", "zh", ...).
#
# A wrong value does NOT error, it returns nonsense. RapidOCR bundles three
# model sets - english, latin and chinese - and loads only ONE per pass. Its
# Chinese recogniser drops inter-word spaces from Latin text, so leaving this
# wrong on an English document is a silent-corruption trap.
#   English                                 -> english set
#   Latin-script mix (de/fr/es/it/pt/nl/pl) -> one 'latin' pass covers all
#   Chinese                                 -> chinese set
#   ja / ko / ar / ru / hi / th ...         -> not readable; those pages index empty
# `editcorag doctor` reports the chosen set and anything it cannot read.
LOCALRAG_OCR_LANGUAGES=en

# ------------------------------------------------------- page routing
# A page is OCR'd when it has no usable text layer OR when the text layer
# it does have scores below route_quality_min (garbled CID fonts, mojibake).
LOCALRAG_ROUTE_MIN_CHARS=50
LOCALRAG_ROUTE_QUALITY_MIN=0.60
LOCALRAG_ROUTE_SCANNED_IMAGE_COVER=0.50
LOCALRAG_ROUTE_HYBRID_IMAGE_COVER=0.15

# -------------------------------------------------------------- ingest
# Bump to invalidate every cached page/chunk and force a clean re-ingest.
LOCALRAG_PIPELINE_VERSION=1
LOCALRAG_BATCH_PAGES=6
# Defaults to min(4, cpu_count-2) to stay off a fanless machine's thermal ceiling.
#LOCALRAG_MAX_WORKERS=4
LOCALRAG_PAGE_TIMEOUT_S=180
LOCALRAG_MAX_PAGE_ATTEMPTS=2

# ------------------------------------------------------------ chunking
LOCALRAG_CHUNK_MAX_TOKENS=600

# -------------------------------------------------------------- server
LOCALRAG_HOST=127.0.0.1
LOCALRAG_PORT=8000

# ------------------------------------------------------------- logging
LOCALRAG_LOG_LEVEL=INFO
LOCALRAG_LOG_JSON=false

# --------------------------------------------------------------- paths
#LOCALRAG_DATA_DIR=./data
